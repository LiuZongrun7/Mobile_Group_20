# 服务端记账与智能体的开关。与 forum.env 分开，因为开关和风险面都不一样。
#
# ⚠️ **2026-09-30 起这个文件不再管"中转转发"了。** 原来这里配的是"用户把自己的
#    上游 key 交给我们、我们替他转发到上游"那一套（域名白名单、防转发环、转发限流），
#    那条路整块删掉了。现在这个开关守的是**记账那几组接口**：
#    用量读取、预算、价目、赛季，以及应用内智能体。
#
#    变量名 `FORUM_ENABLE_RELAY` 和文件名里的 relay 都是历史遗留：它们在 systemd unit
#    （`/etc/tokentrail-forum-relay.env`）和部署脚本里写死了，改名字要同时改服务器上的
#    文件，等下次一起动。
#
# 已经不起作用的四个变量（留着不报错，但也不再生效，别再配了）：
#   FORUM_RELAY_ALLOWED_HOSTS / FORUM_RELAY_ALLOW_PRIVATE /
#   FORUM_RELAY_SELF_HOSTS / FORUM_RELAY_REQUESTS_PER_MINUTE
#   ——它们防的是"我们替用户去请求任意地址"，而这件事已经不存在了。
FORUM_ENABLE_RELAY=1

# 价目表种子的开关。默认 0：价目是**数据**，自动写进生产库会让
# 「这批价是哪来的」变成一个没人说得清的问题。
# 打开后启动时会把内置种子录进去（幂等，**不覆盖已存在的记录**——
# 生产库里可能有人后来录了更准的一版，无条件覆盖会在每次重启时把它冲掉）。
# 种子只含 DeepSeek，依据是 docs/DATA_SOURCES.md §4 的实测记录；
# OpenAI 和 MiMo 没实测过，不编数据（空着 = 界面显示「价格未知」，那是诚实的）。
FORUM_PRICING_SEED=0

# ---------------------------------------------------------------------------
# 应用内 AI 智能体。**用的是我们自己的模型 key**——用户现在不需要交任何 key 给我们。
#
# ⚠️ 这个 key 只在服务端：不进数据库、不进日志、不进任何响应。
#    健康检查只报「配没配」（agentConfigured），永远不报 key 本身。
#
# 没配 key 时 /agent/ask 返回 503 并说明原因，**不会拿别的东西凑一个答案**。
# FORUM_AGENT_KEY=sk-...
FORUM_AGENT_MODEL=deepseek-chat
FORUM_AGENT_ENDPOINT=https://api.deepseek.com
# 智能体每次问答都花我们的钱，所以限流比别的接口严（默认 10 次/分钟）。
FORUM_AGENT_REQUESTS_PER_MINUTE=10
