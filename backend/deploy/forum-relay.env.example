# 中转服务配置。与 forum.env 分开，因为开关和风险面都不一样。
#
# 部署前必读：
# 1. `FORUM_RELAY_ALLOWED_HOSTS` **生产必须填**。留空时只剩「拒绝私网地址」那一层，
#    等于允许用户让我们向任意公网地址发请求。
# 2. `FORUM_RELAY_ALLOW_PRIVATE` 生产必须是 0。它只给本地验收用（假上游在回环上）。
# 3. 这个服务会替用户保管上游 API key。启用之前确认：
#    - nginx 只从 443 暴露 /api/relay/，8010 仍然只监听 127.0.0.1；
#    - 服务器上没有其它对公网开放的端口（`ss -tlnp` 自查）；
#    - /var/lib/tokentrail-forum 的属主和权限没被放宽。
FORUM_ENABLE_RELAY=1
FORUM_RELAY_ALLOWED_HOSTS=api.deepseek.com,api.openai.com,api.xiaomimimo.com
FORUM_RELAY_ALLOW_PRIVATE=0
# 防转发环：用户把上游填成我们自己的地址时直接拒绝。
FORUM_RELAY_SELF_HOSTS=43.140.212.47,127.0.0.1,localhost
# 每个 relay key 每分钟允许的转发次数。
FORUM_RELAY_REQUESTS_PER_MINUTE=240

# 价目表种子的开关。默认 0：价目是**数据**，自动写进生产库会让
# 「这批价是哪来的」变成一个没人说得清的问题。
# 打开后启动时会把内置种子录进去（幂等，**不覆盖已存在的记录**——
# 生产库里可能有人后来录了更准的一版，无条件覆盖会在每次重启时把它冲掉）。
# 种子只含 DeepSeek，依据是 docs/DATA_SOURCES.md §4 的实测记录；
# OpenAI 和 MiMo 没实测过，不编数据（空着 = 界面显示「价格未知」，那是诚实的）。
FORUM_PRICING_SEED=0

# ---------------------------------------------------------------------------
# 应用内 AI 智能体。**用的是我们自己的模型 key，不是用户的上游 key**——
# 所以它和中转是两套东西、账本也分开（agent_usage vs relay_usage）。
#
# ⚠️ 这个 key 只在服务端：不进数据库、不进日志、不进任何响应。
#    健康检查只报「配没配」（agentConfigured），永远不报 key 本身。
#
# 没配 key 时 /agent/ask 返回 503 并说明原因，**不会拿别的东西凑一个答案**。
# FORUM_AGENT_KEY=sk-...
FORUM_AGENT_MODEL=deepseek-chat
FORUM_AGENT_ENDPOINT=https://api.deepseek.com
# 智能体每次问答都花我们的钱，所以限流比转发更严（默认 10 次/分钟）。
FORUM_AGENT_REQUESTS_PER_MINUTE=10
