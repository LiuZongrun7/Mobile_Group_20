MODELPILOT_DATA_DIR=/var/lib/modelpilot-forum-test
MODELPILOT_PUBLIC_ORIGIN=https://43.140.212.47
MODELPILOT_PUBLIC_API_PREFIX=/test-api
MODELPILOT_ENABLE_TEST_SESSIONS=1
MODELPILOT_NEWS_DATABASE=/var/lib/modelpilot-forum/news-readonly.sqlite3
# MODELPILOT_AUTH_URL / MODELPILOT_AUTH_UID_FIELD / MODELPILOT_AUTH_NAME_FIELD 已删除（2026-02）。
# 它们原来指向团队那台机器上的账号服务（127.0.0.1:8000）；账号归我们自己之后
# 鉴权改成查本库的 `accounts` / `account_sessions`，这三个变量**设了也不起作用**。

# ---- 发信：测试区的两种选择（2026-10-05 加）--------------------------------
#
# 1) 真发信：把和正式服务一样的 SMTP_* 四行抄过来（可以共用一个发信账号）。
# 2) 不真发：开回显，验证码直接出现在 `/test-api/account/register` 和
#    `verify/resend` 的响应里（`devCode` 字段），联调不用等邮件。
#
# **回显只在测试区生效**：`Settings.mailer` 的闸门是
# `MODELPILOT_ENABLE_TEST_SESSIONS=1`（本文件上面那行已经有了）。
MODELPILOT_MAIL_DEV_ECHO=1
