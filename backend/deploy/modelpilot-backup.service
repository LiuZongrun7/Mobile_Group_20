[Unit]
Description=Back up TokenTrail forum data

[Service]
Type=oneshot
User=tokentrail
Group=tokentrail
WorkingDirectory=/opt/modelpilot/backend
EnvironmentFile=/etc/modelpilot-forum.env
ExecStart=/opt/modelpilot/venv/bin/python -m modelpilot_forum.backup
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/modelpilot-forum
TimeoutStartSec=180
