[Unit]
Description=TokenTrail English AI and technology RSS import
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tokentrail
Group=tokentrail
WorkingDirectory=/opt/tokentrail/backend
EnvironmentFile=/etc/tokentrail-forum.env
ExecStart=/opt/tokentrail/venv/bin/python -m tokentrail_forum.news_job
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tokentrail-forum
MemoryMax=256M
TimeoutStartSec=180
