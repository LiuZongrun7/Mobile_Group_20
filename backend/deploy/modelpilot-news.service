[Unit]
Description=ModelPilot English AI/technology RSS import
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tokentrail
Group=tokentrail
WorkingDirectory=/opt/modelpilot/backend
EnvironmentFile=/etc/modelpilot-forum.env
ExecStart=/opt/modelpilot/venv/bin/python -m modelpilot_forum.news_job
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/modelpilot-forum
MemoryMax=256M
TimeoutStartSec=180
