[Unit]
Description=TokenTrail forum API
After=network.target

[Service]
User=tokentrail
Group=tokentrail
WorkingDirectory=/opt/tokentrail/backend
EnvironmentFile=/etc/tokentrail-forum.env
ExecStart=/opt/tokentrail/venv/bin/uvicorn tokentrail_forum.app:application --factory --host 127.0.0.1 --port 8010 --workers 1 --no-access-log
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tokentrail-forum
MemoryMax=512M
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
