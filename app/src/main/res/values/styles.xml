<resources>
    <style name="ForumThemeBase" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">#6750A4</item>
        <item name="colorSurface">#FFFBFE</item>
        <item name="colorOnSurface">#1D1B20</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#1D1B20</item>
    </style>
    <style name="ForumTheme" parent="ForumThemeBase" />
    <style name="ForumButtonTheme">
        <item name="materialButtonStyle">@style/Widget.Material3.Button.TextButton</item>
    </style>
    <style name="NewsThumbnailShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">6dp</item>
    </style>

    <!-- Base application theme.
         Material3 ships its own full colour palette (colorPrimary, colorSecondary,
         surfaces, ...) and a matching dark palette, so nothing needs to be
         overridden here to get a consistent look.

         NoActionBar: the app draws its own top area. To get a title bar back,
         use Theme.Material3.DayNight with a MaterialToolbar in the layout. -->
    <style name="AppThemeBase" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- 状态栏和手势条：游戏页搬走之后**整页都是浅色**了，所以图标一律用深色。
             条本身设成透明，让页面底色一直铺到屏幕最上/最下边：
             MainActivity 里还有一句 WindowCompat.setDecorFitsSystemWindows(false)，
             两句配一套（少一句，透明条后面就是黑的或者旧主题色）。

             showTab 每一页都会再设一次（WindowInsetsControllerCompat），
             这里只是启动那一瞬间的默认值。 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="AppTheme" parent="AppThemeBase" />

    <!-- 导出对话框里的小标题（范围 / 用量范围 / 格式）与它下面那行说明。
         抽成样式是因为同一个对话框里有三段，逐段复制属性迟早会有一段漏掉
         （漏了 paddingEnd 就会顶到边上，很难看但不会报错）。 -->
    <style name="ExportSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textColor">#0B1B33</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ExportSubtitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">38dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textColor">#7A8699</item>
        <item name="android:textSize">12sp</item>
    </style>

</resources>
