<resources>

    <!-- Base application theme.
         Material3 ships its own full colour palette (colorPrimary, colorSecondary,
         surfaces, ...) and a matching dark palette, so nothing needs to be
         overridden here to get a consistent look.

         NoActionBar: the app draws its own top area. To get a title bar back,
         use Theme.Material3.DayNight with a MaterialToolbar in the layout. -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Android 15+ forces edge-to-edge, so the status bar is transparent and
             is no longer tinted by colorPrimaryDark. On a light background the
             icons must be dark to stay readable. The value is flipped back to
             false in values-night/styles.xml. -->
        <item name="android:windowLightStatusBar">true</item>
    </style>

</resources>
