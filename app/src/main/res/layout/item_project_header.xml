<?xml version="1.0" encoding="utf-8"?>
<!--
  一个项目分组的表头（设计稿首页 "⌄ 📁 Campus event 2        +"）。

  右边那个 `+` 是"在这个项目里新建一条对话"，**不是"新建项目"**——
  新建项目在上面的 `Projects` 那一行。两个加号长得一样、做的事不一样，
  所以它们各自的 contentDescription 必须写清楚（`chat_new_chat_in_project`）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/project_chevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/chat_collapse_project"
        android:src="@drawable/ic_chevron_down"
        app:tint="#5B6B82" />

    <ImageView
        android:id="@+id/project_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_folder_closed"
        app:tint="#7C5CD6" />

    <TextView
        android:id="@+id/project_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#0B1B33"
        android:textSize="17sp"
        android:textStyle="bold"
        tools:text="Campus event" />

    <!-- 条数。**只在大于 0 时显示**：空项目旁边挂个 "0" 只会让人以为坏了。 -->
    <TextView
        android:id="@+id/project_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="#9AA5B6"
        android:textSize="15sp"
        tools:text="2" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <ImageView
        android:id="@+id/project_settings"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/project_instructions_title"
        android:padding="9dp"
        android:src="@drawable/ic_project_settings"
        app:tint="#7A8699" />

    <ImageView
        android:id="@+id/project_add_chat"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/chat_new_chat_in_project"
        android:padding="8dp"
        android:src="@drawable/ic_plus"
        app:tint="#0B1B33" />
</LinearLayout>
