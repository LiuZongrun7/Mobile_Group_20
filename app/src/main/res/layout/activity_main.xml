<?xml version="1.0" encoding="utf-8"?>
<!--
  主界面。**两层**：

    0.   背景 —— 整页的浅色底（游戏页搬走之后不再有岩石底那一层）。
    1.   界面 —— 底部导航，以及它上面的三个页面。同一时刻只显示一个：
                 统计页是真的（@id/dashboard_page），论坛页是 Fragment
                 （@id/forum_page），「我的」页共用 @id/empty_page 空壳。

  塔防游戏那一版（岩石底 + 战场 + HUD + 操作行 + 商店弹窗）已经整块移出本工程
  （2026-09-30，产品方向改成 ModelPilot）。连同它那套三层结构的说明，一起放在
  与本工程同级的 `../ModelPilot_Game/` 里，要翻旧账或搬回来去那边找。

  界面这一层里，统计页自己可滚动（ScrollView），没有别的固定段了；内容层
  上下留出系统栏的位置（fitsSystemWindows），别让第一行字压在状态栏底下。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">


    <!-- ==================== 1. 界面 ====================
         这一层里装着**三个页面**（底部导航那三项），同一时刻只显示一个。
         游戏页已经整块搬走（见文件头注释）；论坛是 Fragment，统计是真的，
         「我的」共用下面那个 @id/empty_page 空壳——见文件末尾那段注释。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true">


        <!-- ===== 1.4 Dashboard 首页 =====
             这是真正的 ModelPilot 落地页：统计、人民币估算、预算进度、数据覆盖、
             provider breakdown、Price Center、AI Assistant 和论坛摘要。
             先用现有 UsageRepository 的 monthTokens 驱动核心数字，后续接真实 dashboard 包时
             可以整体迁移成 Fragment。 -->
        <ScrollView
            android:id="@+id/dashboard_page"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dashboard_page"
            android:fillViewport="true"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:src="@mipmap/ic_launcher"
                        android:contentDescription="@string/app_name" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ModelPilot"
                            android:textColor="#071957"
                            android:textSize="30sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Track · Analyse · Optimise"
                            android:textColor="#5F6F94"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/dashboard_price_icon"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_dashboard_chip"
                        android:gravity="center"
                        android:text="¥"
                        android:textColor="#0878F6"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dashboard_chip"
                        android:gravity="center"
                        android:text="📅  This Month"
                        android:textColor="#071957"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:id="@+id/dashboard_month_label"
                        android:text="This month"
                        android:textColor="#071957"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="132dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dashboard_card"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Monthly Tokens"
                            android:textColor="#071957"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/dashboard_month_tokens"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:textColor="#071957"
                            android:textSize="27sp"
                            android:textStyle="bold"
                            tools:text="1,248,320" />

                        <TextView
                            android:id="@+id/dashboard_token_delta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_dashboard_soft_teal"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:text="From recorded usage"
                            android:textColor="#0A8F7F"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="132dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dashboard_card"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Estimated CNY Spend"
                            android:textColor="#071957"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/dashboard_cny_spend"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:textColor="#071957"
                            android:textSize="27sp"
                            android:textStyle="bold"
                            tools:text="¥86.53" />

                        <TextView
                            android:id="@+id/dashboard_spend_delta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_dashboard_soft_teal"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:text="Based on available costs"
                            android:textColor="#0A8F7F"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="132dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dashboard_card"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Budget Progress"
                            android:textColor="#071957"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="16dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/dashboard_budget_percent"
                                android:layout_width="66dp"
                                android:layout_height="66dp"
                                android:background="@drawable/bg_dashboard_soft_teal"
                                android:gravity="center"
                                android:textColor="#071957"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                tools:text="62%" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/dashboard_budget_text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="#071957"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    tools:text="¥86.53 / ¥140.00" />

                                <TextView
                                    android:id="@+id/dashboard_runway"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="Available after wallet setup"
                                    android:textColor="#0A9F72"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="132dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dashboard_card"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Recorded Days"
                            android:textColor="#071957"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/dashboard_missing_percent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="--"
                            android:textColor="#071957"
                            android:textSize="27sp"
                            android:textStyle="bold" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_dashboard_progress">

                            <View
                                android:id="@+id/dashboard_coverage_fill"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_dashboard_progress_fill" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:id="@+id/dashboard_coverage_note"
                            android:text="Days with at least one usage record"
                            android:textColor="#5F6F94"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="240dp"
                        android:layout_weight="1.4"
                        android:background="@drawable/bg_dashboard_card"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Token Usage Trend"
                                android:textColor="#071957"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_dashboard_chip"
                                android:gravity="center"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:text="Tokens"
                                android:textColor="#0878F6"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/dashboard_trend_bars"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="18dp"
                            android:layout_weight="1"
                            android:gravity="bottom"
                            android:orientation="horizontal" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:id="@+id/dashboard_trend_range"
                            android:text="Recent completed days"
                            android:textColor="#6F7C9D"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="240dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dashboard_card"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Provider Breakdown"
                            android:textColor="#071957"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/dashboard_provider_openai"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:textColor="#071957"
                            android:textSize="13sp"
                            tools:text="OpenAI  52%\n647,210 tokens · ¥45.12" />

                        <TextView
                            android:id="@+id/dashboard_provider_mimo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:textColor="#071957"
                            android:textSize="13sp"
                            tools:text="Xiaomi MiMo  24%\n299,880 tokens" />

                        <TextView
                            android:id="@+id/dashboard_provider_deepseek"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:textColor="#071957"
                            android:textSize="13sp"
                            tools:text="DeepSeek  15%\n187,420 tokens" />

                        <TextView
                            android:id="@+id/dashboard_provider_other"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:visibility="gone"
                            android:textColor="#071957"
                            android:textSize="13sp"
                            tools:text="Others  9%\n113,810 tokens · ¥4.23" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/dashboard_price_card"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dashboard_soft_amber"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:gravity="center"
                            android:text="🪙"
                            android:textSize="32sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Price Center"
                                android:textColor="#071957"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Prices and official top-up links"
                                android:textColor="#5F6F94"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/dashboard_ai_card"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dashboard_soft_blue"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:gravity="center"
                            android:text="🤖"
                            android:textSize="32sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="AI Assistant"
                                android:textColor="#071957"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Ask about usage, costs and coverage"
                                android:textColor="#5F6F94"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_dashboard_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Latest from Forum"
                        android:textColor="#071957"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="🔥  OpenAI announces GPT-4.1 with lower input price\n      2 hours ago · 128 replies"
                        android:textColor="#071957"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="💬  Best practices for long context to reduce costs?\n      5 hours ago · 63 replies"
                        android:textColor="#071957"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="📣  Anthropic launches Claude 3.7 with coding gains\n      1 day ago · 210 replies"
                        android:textColor="#071957"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <!-- ===== 1.3 Chat 页 =====
             新建主线的落地页（设计稿 `01-home.png`）：项目分组 + 最近对话 + 底部输入条。
             内容是 Fragment（`ChatHomeFragment`），因为它要跟着 Room 的 LiveData 自己刷，
             而这一层只负责"哪一页可见"。 -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/chat_page"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />

        <!-- ===== 1.4 「我的」/论坛占位与页面 =====
             共用空壳，由 MainActivity.showTab 填提示文案。论坛是下方独立容器。
             页面底色由 showTab 统一刷成浅色（游戏页搬走后不再有岩石底）。 -->
        <FrameLayout
            android:id="@+id/empty_page"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">
            <TextView
                android:id="@+id/empty_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                tools:text="Dashboard is not built yet" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/account_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/account_title"
                android:visibility="gone" />
            <!-- API keys 的入口。**只在「我的」页出现**：填 key 是一件低频、要慎重的事，
                 放在聊天页的常用路径上会被误点，而它没有"撤销"（删了要重填一遍）。 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/api_keys_button"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/keys_title"
                android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/forum_page"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />

        <!-- ===== 1.5 底部导航 =====
             浅色页面配浅色导航（原来游戏页要深色岩石，才有一套透明的深色导航）。
             底白、图标和文字用 forum_nav_item 那套；
             elevation=0：不然它会给自己画一道矩形投影，凭空多一条横线。

             **2026-09-27 压过高度**（80dp → 见下）：默认 `?attr/minHeight` 是 80dp，
             这里把 minHeight 归零、图标和上下留白都收小。这块是纯导航，
             缩一点不影响主操作。 -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:elevation="0dp"
            android:minHeight="0dp"
            app:itemIconSize="20dp"
            app:itemIconTint="@color/forum_nav_item"
            app:itemPaddingBottom="2dp"
            app:itemPaddingTop="2dp"
            app:itemTextColor="@color/forum_nav_item"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav" />

    </LinearLayout>

</FrameLayout>
