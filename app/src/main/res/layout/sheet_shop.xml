<?xml version="1.0" encoding="utf-8"?>
<!--
  商店弹窗（BottomSheetDialog 的内容）。

  **它用的是游戏页那套固定配色，不跟随系统深浅色**：整页的底是岩石美术，
  弹窗要是跟着主题翻成白色，会在深色战场上方撕出一大块亮面。所以这里的文字
  一律 GameText / GameText.Dim，底是 bg_sheet（岩石那档色 + 上面两个圆角）。

  结构自上而下：

    标题 + 换算率  —— 换算率原来在 HUD 底下，挪进来了：它是"资源从哪来"的说明，
                      和价格放在一起才读得懂。
    余额           —— 三种资源各一格。"这个数字和我买得起什么有关"是这一屏
                      要回答的第一个问题。
    货架           —— 由 MainActivity 按 game/engine/ShopCatalog 填，
                      每行是 layout/item_shop.xml。**不写死在 XML 里**：
                      加一种建筑只改 ShopCatalog。
    只看不放       —— 把手上那件放回去。没有它的话，选中之后就没法取消了
                      （底下那排选建筑的按钮已经删了）。

  为什么选建筑要进弹窗：买一件东西要同时说清楚"占地多大、花什么、花多少"，
  横排按钮一行只塞得下四个字，说不清价格；而且每加一种建筑就要多挤一格，
  底下一挤，战场上的格子就小一档（ART.md §2.1）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingTop="16dp"
    android:paddingBottom="20dp">

    <TextView
        style="@style/GameText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="@string/shop_title"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textStyle="bold" />

    <TextView
        style="@style/GameText.Dim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="@string/shop_rate"
        android:textAppearance="?attr/textAppearanceLabelSmall" />

    <!-- 余额：三种资源各一格，和 HUD 上那四个 token 桶是同一套色点。
         数字在 MainActivity.renderShop 里填。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/resource_input" />

            <TextView
                android:id="@+id/shop_bal_input"
                style="@style/GameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                tools:text="Input 541" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/resource_cache" />

            <TextView
                android:id="@+id/shop_bal_cache"
                style="@style/GameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                tools:text="Cache 353" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/resource_output" />

            <TextView
                android:id="@+id/shop_bal_output"
                style="@style/GameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                tools:text="Output 95" />
        </LinearLayout>
    </LinearLayout>

    <!-- 货架。MainActivity 按 ShopCatalog 往里加 item_shop.xml。 -->
    <LinearLayout
        android:id="@+id/shop_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/shop_look_only"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="20dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/shop_look_only"
        android:textColor="@color/on_mountain"
        app:backgroundTint="@color/glass_button" />

</LinearLayout>
