<?xml version="1.0" encoding="utf-8"?>
<!--
  Insights（第 4 屏）：**读本机账本**（`usage_call` 里 source=APP 的那些）。

  和旧统计页的区别：旧页读的是 `daily_usage`（只滚导入记录）且用的是桩数据，
  所以它显示的数字和"这个 App 真实花了多少"没有关系。这一页的每个数字都能追回
  账本里的原始行。

  三段：本月的数（token / 金额 / 次数）、本地月度上限、按 provider 与按模型的分解。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nav_insights"
            android:textColor="#0B1B33"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/insights_month"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#7A8699"
            android:textSize="13sp"
            tools:text="October 2026 · this device" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_dashboard_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/insights_tokens"
                    android:textColor="#0B1B33"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/insights_tokens_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#0B1B33"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    tools:text="1,248,320" />

                <TextView
                    android:id="@+id/insights_tokens_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#7A8699"
                    android:textSize="11sp"
                    tools:text="in 1.1M · cache 120K · out 28K" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dashboard_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/insights_cost"
                    android:textColor="#0B1B33"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/insights_cost_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#0B1B33"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    tools:text="$0.42" />

                <!-- **算不出价的那几次必须单独说**：不然这个金额看起来像"全部"。 -->
                <TextView
                    android:id="@+id/insights_cost_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#7A8699"
                    android:textSize="11sp"
                    tools:text="3 calls have no price yet" />
            </LinearLayout>
        </LinearLayout>

        <!--
          币种与汇率（2026-10-05 加）。

          **App 不带任何内置汇率**：选了人民币就必须用户自己填，填的时候连来源和日期
          一起记（留痕），没填就退回美元显示并在下面说明。这样屏幕上每个金额都能回答
          "这是账本原值，还是按谁的汇率折的"。
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_dashboard_card"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/insights_currency"
                    android:textColor="#0B1B33"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/insights_currency_change"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="@string/insights_currency_change"
                    android:textColor="#1E7BF6"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/insights_currency_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#0B1B33"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Chinese yuan (¥)" />

            <!-- 汇率带着**来源和日期**一起显示：汇率是时点值，光有一个数字没法核对。 -->
            <TextView
                android:id="@+id/insights_fx_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#7A8699"
                android:textSize="12sp"
                tools:text="1 USD = 7.15 CNY · 2026-10-05 · bank rate" />

            <TextView
                android:id="@+id/insights_fx_set"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="?attr/selectableItemBackground"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="@string/insights_fx_set"
                android:textColor="#1E7BF6"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/insights_currency_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#7A8699"
                android:textSize="11sp"
                tools:text="CNY is selected but no rate is set yet, so amounts stay in USD." />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_dashboard_card"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/insights_budget"
                    android:textColor="#0B1B33"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/insights_budget_set"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="@string/insights_budget_set"
                    android:textColor="#1E7BF6"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/insights_budget_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#0B1B33"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="$0.42 / $20.00" />

            <ProgressBar
                android:id="@+id/insights_budget_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="8dp"
                android:max="100"
                tools:progress="12" />

            <TextView
                android:id="@+id/insights_budget_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#7A8699"
                android:textSize="11sp"
                tools:text="A local limit only. No payment, top-up or plan is involved." />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/insights_routing"
            android:textColor="#0B1B33"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/insights_routing_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_dashboard_card"
            android:padding="14dp"
            android:textColor="#0B1B33"
            android:textSize="13sp"
            tools:text="Auto 8 of 11 answers (73%) · 2 compressions" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/insights_providers"
            android:textColor="#0B1B33"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/insights_providers_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/insights_models"
            android:textColor="#0B1B33"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/insights_models_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/insights_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/insights_empty"
            android:textColor="#7A8699"
            android:textSize="13sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/insights_footnote"
            android:textColor="#9AA5B6"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
