<?xml version="1.0" encoding="utf-8"?>
<!--
  「这条对话的记忆」弹层（对话页 `⋮ → Conversation memory`）。

  **它是大纲 §4 那条 "inspect/correct the retained memory" 的落点**：
  压缩把更早的轮变成了一段摘要，那段摘要此后每一轮都要带上——用户必须能看见它、
  改它、或者干脆丢掉它（丢掉之后原文重新进上下文）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:paddingTop="8dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#E1E5EC" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:text="@string/memory_title"
        android:textColor="#0B1B33"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="6dp"
        android:paddingEnd="20dp"
        android:text="@string/memory_explainer"
        android:textColor="#7A8699"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:id="@+id/memory_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- 还没有记忆：说清楚"什么时候会有"，而不是只留一片空白。 -->
            <TextView
                android:id="@+id/memory_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/memory_empty"
                android:textColor="#7A8699"
                android:textSize="13sp"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
