<?xml version="1.0" encoding="utf-8"?>
<!--
  商店里的一件商品。由 MainActivity.renderShop 按 ShopCatalog 填，
  所以这里的文字全是 tools: 占位，没有 android:text。

  左边两行：名称（BuildingType.label，代码里的唯一出处）+ 占地多大；
  右边：价格。**买不起的那一件整行压暗**（在代码里调 alpha），
  这样一眼扫过去就知道现在能买什么，不用一个个点。

  底是玻璃胶囊 + 水波纹前景（bg_shop_row 只给 mask，不会盖住玻璃底色）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_pill"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/bg_shop_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_name"
            style="@style/GameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            tools:text="Tower" />

        <TextView
            android:id="@+id/item_note"
            style="@style/GameText.Dim"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            tools:text="2×2 · 4 cells" />
    </LinearLayout>

    <TextView
        android:id="@+id/item_cost"
        style="@style/GameText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:gravity="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        tools:text="Cache 25 + Output 10" />

</LinearLayout>
