<?xml version="1.0" encoding="utf-8"?>
<!--
  用户的一条消息：浅蓝气泡 +（可选）图片缩略图 + 正文。

  **缩略图在文字上方**：先看图再看话，和设计稿里"Poster.png 那张图 + 下面一句指令"
  的顺序一致。没有图片时 ImageView 整块 GONE，气泡就是一个纯文字气泡。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="end"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_chat_user_bubble"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <!-- 缩略图。**在解码时就缩到不超过 THUMBNAIL_MAX_PX**（见 ChatConversationFragment）：
         一张 4000px 的原图直接解码进 ImageView 会吃掉几十 MB，几张就把 App 撑爆。 -->
    <ImageView
        android:id="@+id/message_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:adjustViewBounds="true"
        android:maxHeight="220dp"
        android:contentDescription="@string/chat_attach_image_cd"
        android:visibility="gone"
        tools:src="@mipmap/ic_launcher"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/message_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#0B1B33"
        android:textSize="15sp"
        tools:text="Make the background blue. Keep the layout." />
</LinearLayout>
