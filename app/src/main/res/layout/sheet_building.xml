<?xml version="1.0" encoding="utf-8"?>
<!--
  建筑详情（BottomSheetDialog 的内容）。点场上任意一座建筑都会弹这个。

  **和商店同一套固定配色**，理由见 sheet_shop.xml：游戏页是固定美术，弹窗跟着
  主题翻白会在深色战场上撕出一大块亮面。

  结构自上而下：

    名字 + 等级  —— "Tower · Level 2"。等级就写在这儿而不是单开一行：
                    它是这一屏的主语，后面所有数值都是"在这个等级上"的。
    占地         —— 2×2。放第二座之前得知道它还占得下不。
    耐久         —— 还剩多少 / 满多少。**三种建筑都有**，所以这一行不会藏。
    攻击范围     —— 只有会攻击的建筑（现在只有塔）才有这一行，
                    不攻击的（墙、核心）整行 GONE。**"没有攻击"不写出来**：
                    写一行"Attack range 0"会让人以为它能打、只是打不到人。
    升级价       —— 升下一级要多少钱。**2026-09-27 从场上的操作条搬进来的**：
                    那条只剩三个图标方框，价钱在屏幕上没有别的地方写了。
                    到顶了写"Max level"（那行还在，只是换了内容）。
    关闭         —— "能关"这件事得有个明说的出口，不然第一次用的人会以为面板粘住了。

  为什么点建筑就该出这个面板、而不是接着放东西：见 BattlefieldView.Inspector
  的注释——"想看一眼已有的塔，结果在旁边又冒出一座还扣了钱"。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingTop="16dp"
    android:paddingBottom="20dp">

    <!-- 名字 + 等级 -->
    <TextView
        android:id="@+id/bld_name"
        style="@style/GameText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textStyle="bold"
        tools:text="Tower · Level 2" />

    <!-- 占地。同样不写"共几格"，理由见 strings.xml 里 shop_size 那段。 -->
    <TextView
        android:id="@+id/bld_size"
        style="@style/GameText.Dim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        tools:text="2×2" />

    <!-- 耐久。**三种建筑都有这一行**——塔、墙、核心都有血，所以它不像攻击范围
         那样会整行 GONE。用血条那个绿（game_hp_good）而不是新挑一个色：
         面板上的数字和战场上那条血条说的是同一件事，颜色一样才不用去猜。 -->
    <LinearLayout
        android:id="@+id/bld_hp_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="12dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/game_hp_good" />

        <TextView
            android:id="@+id/bld_hp"
            style="@style/GameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            tools:text="Durability 100 / 100" />
    </LinearLayout>

    <!-- 攻击范围。只有会攻击的建筑才显示（MainActivity.renderBuildingSheet 控制）。
         用金子那个颜色，和战场上画出来的圈是同一个色——面板上的数字和地上的圈
         对得上，才不用去想"这是不是同一个东西"。 -->
    <LinearLayout
        android:id="@+id/bld_range_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="12dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/game_range" />

        <TextView
            android:id="@+id/bld_range"
            style="@style/GameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            tools:text="Attack range 3.0 cells" />
    </LinearLayout>

    <!-- 升级价。**这一行是 2026-09-27 新加的，因为条子上那串价没了**
         （三个方框只剩图标）。它还回来的正是"按下去之前唯一想知道的数"。

         用金色那三个资源标记里对应的颜色是做不到的（一排可能同时吃两种资源），
         所以这里用一个中性的圆点，颜色沿用射界那一格的黄：这一屏上
         "黄色 = 关于这座建筑还能变成什么样"，耐久那个绿仍然是"现在还剩多少"。
         到顶了写 "Max level"，不是不显示——**不显示的话玩家不知道
         是"没有下一级"还是"这里没写"。 -->
    <LinearLayout
        android:id="@+id/bld_cost_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="12dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/game_range" />

        <TextView
            android:id="@+id/bld_cost"
            style="@style/GameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            tools:text="Upgrade cost Cache 20 + Output 8" />
    </LinearLayout>

    <!-- 剩下只有一个"关闭"。

         **升级 / 整排 / 挪动三个按钮全搬去了场上那条悬浮操作条**
         （@id/building_bar）。这一屏现在只回答一个问题："这一座现在什么样"。

         分成两处是因为它们本来就要同时在场：悬浮条贴在选中那一座旁边，
         手指不用离开战场；而数值（耐久、射界、价格）铺开来读需要一大片地方，
         只有底部弹窗放得下。以前硬挤在一个模态弹窗里，代价是**弹窗开着时
         战场收不到触摸**——"点一下建筑直接拖着它走"这条手感就没了。 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/bld_close"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/bld_close"
        android:textColor="@color/on_mountain"
        app:backgroundTint="@color/glass_button" />

</LinearLayout>
