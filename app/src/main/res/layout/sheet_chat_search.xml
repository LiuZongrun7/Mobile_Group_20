<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="20dp" android:background="#FFFFFF">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/history_search_title" android:textSize="22sp" android:textStyle="bold" android:textColor="#0B1B33" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="@string/history_search_note" android:textSize="12sp" android:textColor="#7A8699" />
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:hint="@string/history_search_hint" app:endIconMode="clear_text">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/search_query"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text"
            android:maxLines="1" android:maxLength="160" android:imeOptions="actionSearch" />
    </com.google.android.material.textfield.TextInputLayout>
    <Spinner android:id="@+id/search_project" android:layout_width="match_parent" android:layout_height="48dp"
        android:contentDescription="@string/history_search_project" />
    <TextView android:id="@+id/search_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="8dp" android:paddingBottom="8dp" android:accessibilityLiveRegion="polite"
        android:textColor="#7A8699" android:text="@string/history_search_prompt" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/search_results"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:contentDescription="@string/history_search_results" />
</LinearLayout>
