<?xml version="1.0" encoding="utf-8"?>
<!-- 操作条上的"整排"。三根竖条，就是"一排建筑"。

     **三根而不是两根或四根**：两根读起来像"复制一份"，四根在 24dp 下
     每一根只剩 3dp 宽、压在草地上会糊成一块。三根正好同时说得出
     "好几个"和"排成一列"。

     和 @drawable/ic_bar_single 是**一对**：按下去之后图标换成那一根，
     所以这两个文件的条宽、间距必须一模一样（都是 4dp 宽、6dp 间隔），
     换图标时那三根里中间那根才会留在原地不动。

     颜色写死白色，实际显示由 ImageView 的 tint 决定。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4,6h4v12H4zM10,6h4v12h-4zM16,6h4v12h-4z" />
</vector>
