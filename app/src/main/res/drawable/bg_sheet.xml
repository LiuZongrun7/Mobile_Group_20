<?xml version="1.0" encoding="utf-8"?>
<!-- 商店弹窗的底。**不跟随系统深浅色**：这一页整页是固定的岩石美术，
     弹窗要是跟着主题翻成白色，会在深色的战场上方撕出一大块亮面。
     所以这里直接用岩石那档色（game_mountain_deep），只圆上面两个角
     ——下面那两个角贴着屏幕底边，圆了也看不见。

     用 BottomSheetDialog 时还要把它的容器底色设成透明，否则圆角外面会露出
     主题的 surface（见 MainActivity.showShop）。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/game_mountain_deep" />
    <corners
        android:topLeftRadius="20dp"
        android:topRightRadius="20dp" />
</shape>
