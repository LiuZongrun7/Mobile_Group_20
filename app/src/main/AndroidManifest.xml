<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".ModelPilotApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- 锁定竖屏：战场是按「宽度定列数、高度定行数」算出来的（见 BoardGeometry），
             一转屏面板的长宽比就变了，战场形状会中途变掉。游戏和面板都是竖屏设计。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.forum.NewsReaderActivity" android:exported="false"
            android:theme="@style/ForumTheme" />

        <!-- 「打开附件原文件」用的出口（`ui/chat/ChatConversationFragment.viewFile`）。
             图片的字节就存在对话库里（data URL），要交给系统图片查看器就得先写成一个
             文件；而 Android 7 起 `file://` 的 uri 不能直接发给别的 App
             （FileUriExposedException，防的是把私有路径漏出去），所以走 FileProvider
             换成 `content://` + 一次性读权限。

             `authorities` 用包名 + `.attachments`：和 Fragment 里那句
             `getPackageName() + ".attachments"` 是同一个值，改一处必须改两处。
             只暴露缓存下的 `attachments/` 一个子目录（见 res/xml/file_paths.xml）。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.attachments"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
